{
  "name": "gsoft-erp",
  "private": true,
  "version": "1.0.19",
  "author": "GSoft Ahmedabad",
  "description": "Retail ERP Fashion Edition",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview",
    "relay": "node --env-file=.env.local server/index.js",
    "typecheck": "tsc -b --force",
    "start": "concurrently -n relay,app -c magenta,cyan \"npm:relay\" \"npm:dev\"",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "electron-updater": "^6.8.3",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gsoft.retailerp",
    "productName": "Retail ERP",
    "copyright": "Copyright 2026 GSoft, Ahmedabad",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Retail ERP",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "artifactName": "RetailERP-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "VastkinInc",
      "repo": "retailerp-updates",
      "private": false,
      "releaseType": "release"
    },
    "asar": true,
    "portable": {
      "artifactName": "RetailERP-Portable-${version}.${ext}"
    }
  }
}
